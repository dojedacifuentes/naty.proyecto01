  "PK_RUP_PLA_NOMBRE": "SEGURIDAD CLOUD",
  "FL_RUP_PLA_CREADO_FEC": "2024-12-11T15:30:09.597",
  "FL_RUP_PLA_ACTIVO": true,
  "FL_RUP_PLA_FECVIGPER": null,
  "FL_RUP_PLA_DURACION": 201,
  "FL_RUP_PLA_DESCOPYC": "ESTE PLAN FORMATIVO ESTÁ DISEÑADO PARA PROPORCIONAR LOS CONOCIMIENTOS Y HABILIDADES ESENCIALES EN LA PROTECCIÓN, MONITOREO Y ADMINISTRACIÓN DE SERVICIOS Y DATOS EN LA NUBE. LOS PARTICIPANTES DESARROLLARÁN COMPETENCIAS PARA GESTIONAR LA SEGURIDAD EN ENTORNOS CLOUD A TRAVÉS DE LA IMPLEMENTACIÓN DE SOLUCIONES AVANZADAS COMO IAM, PROTECCIÓN DE REDES, GESTIÓN DE IDENTIDAD Y ACCESO, CUMPLIMIENTO NORMATIVO Y AUDITORÍA. ADEMÁS, APRENDERÁN A APLICAR NORMATIVAS INTERNACIONALES Y DESARROLLAR ESTRATEGIAS DE CONTINUIDAD DEL NEGOCIO. LOS PARTICIPANTES PODRÁN DESEMPEÑARSE COMO ESPECIALISTAS EN SEGURIDAD CLOUD EN ORGANIZACIONES QUE UTILICEN TECNOLOGÍAS EN LA NUBE Y REQUIERAN PROTECCIÓN CONTRA CIBERAMENAZAS. LAS PRINCIPALES INDUSTRIAS DE OCUPACIÓN INCLUYEN SECTORES COMO TELECOMUNICACIONES, BANCA, SALUD, RETAIL, SERVICIOS Y CUALQUIER EMPRESA QUE GESTIONE INFRAESTRUCTURA TECNOLÓGICA CRÍTICA EN ENTORNOS DE NUBE PÚBLICA, PRIVADA O HÍBRIDA.<br />",
  "FL_RUP_PLA_PERFSOCUP": "SIN PERFIL DE CHILEVALORA ASOCIADO",
  "FL_RUP_PLA_REQOTEC": "ESTE PLAN FORMATIVO FUE CREADO EN EL CONTEXTO DEL PROGRAMA TALENTO DIGITAL PARA CHILE, POR TANTO, DEBERÁ SER DICTADO POR BOOTCAMPS QUE CUENTEN CON ROL DE OTEC O BIEN, POR OTEC EN CONVENIO CON BOOTCAMPS YA SEA NACIONALES O INTERNACIONALES.",
  "FL_RUP_PLA_LICHABPART": "SIN INSTRUMENTO HABILITANTE",
  "FL_RUP_PLA_REQINGRE": "EGRESADO DE CARRERAS TÉCNICAS DE NIVEL SUPERIOR Y/O PROFESIONALES DE BASE TECNOLÓGICA O AFÍN, MÁS LA APROBACIÓN DE UN TEST DE SELECCIÓN EN LÍNEA QUE EVALÚA LA CAPACIDAD DE APRENDIZAJE Y RESOLUCIÓN DE PROBLEMAS Y LA APROBACIÓN DE TEST CONOCIMIENTOS BASALES DEL ÁREA.",
  "FL_RUP_PLA_COMPPLAN": "GESTIONAR LA SEGURIDAD EN ENTORNOS CLOUD, IMPLEMENTANDO SOLUCIONES AVANZADAS DE PROTECCIÓN, MONITOREO Y CUMPLIMIENTO NORMATIVO, ASEGURANDO LA INTEGRIDAD, CONFIDENCIALIDAD Y DISPONIBILIDAD DE LA INFORMACIÓN Y LOS SERVICIOS CRÍTICOS EN LA NUBE ACORDE LAS BUENAS PRÁCTICAS DE LA INDUSTRIA.",

  "FL_RUP_PLA_DURACION": 220,
  "FL_RUP_PLA_DESCOPYC": "ESTE PLAN FORMATIVO ESTÁ ORIENTADO A DESARROLLAR LAS COMPETENCIAS NECESARIAS PARA DISEÑAR, IMPLEMENTAR Y ADMINISTRAR AUTOMATIZACIONES EMPRESARIALES INTELIGENTES MEDIANTE EL USO DE HERRAMIENTAS LOW CODE/NO CODE COMO N8N Y MAKE, INTEGRADAS CON SERVICIOS DE INTELIGENCIA ARTIFICIAL, AGENTES CONVERSACIONALES Y APIS EXTERNAS. LOS PARTICIPANTESAPRENDERÁN A CREAR FLUJOS DE TRABAJO AUTOMATIZADOS, SOLUCIONES DE INTEGRACIÓN Y AGENTES BASADOS EN IA, APLICANDO METODOLOGÍAS DE ANÁLISIS, CONFIGURACIÓN Y GESTIÓN DE PROCESOS DIGITALES. AL FINALIZAR, LOS EGRESADOS ESTARÁN PREPARADOS PARA DESEMPEÑARSE COMO ESPECIALISTAS EN AUTOMATIZACIÓN DE PROCESOS, CONSULTORES EN INTEGRACIÓN TECNOLÓGICA O DESARROLLADORES DE SOLUCIONES INTELIGENTES EN ORGANIZACIONES QUE BUSCAN OPTIMIZAR SU EFICIENCIA OPERATIVA MEDIANTE AUTOMATIZACIÓN, INTELIGENCIA ARTIFICIAL Y HERRAMIENTAS LOW CODE. SU CAMPO LABORAL ABARCA SECTORES COMO TECNOLOGÍAS DE LA INFORMACIÓN, SERVICIOS FINANCIEROS, EDUCACIÓN, RETAIL, MANUFACTURA Y TRANSFORMACIÓN DIGITAL.",
  "FL_RUP_PLA_PERFSOCUP": "SIN PERFIL DE CHILEVALORA ASOCIADO",
  "FL_RUP_PLA_REQOTEC": "SIN REQUISITOS ESPECIALES",
  "FL_RUP_PLA_LICHABPART": "SIN LICENCIAS HABILITANTES",
  "FL_RUP_PLA_REQINGRE": "EGRESADO DE CARRERA TÉCNICA, PROFESIONAL O UNIVERSITARIA DEL ÁREA TECNOLÓGICA O AFÍN MANEJO COMPUTACIONAL A NIVEL USUARIO. APROBACIÓN DE UN TEST DE SELECCIÓN EN LÍNEA, QUE EVALÚA LA CAPACIDAD DE APRENDIZAJE Y RESOLUCIÓN DE PROBLEMAS Y LA APROBACIÓN DE TEST CONOCIMIENTOS BASALES DEL ÁREA.",
  "FL_RUP_PLA_COMPPLAN": "IMPLEMENTAR SOLUCIONES DE AUTOMATIZACIÓN DE WORKFLOWS EMPRESARIALES UTILIZANDO HERRAMIENTAS LOW CODE/NO CODE COMO N8N Y MAKE, INTEGRANDO SERVICIOS DE INTELIGENCIA ARTIFICIAL, AGENTES CONVERSACIONALES, APIS EXTERNAS Y LÓGICA PERSONALIZADA, PARA OPTIMIZAR PROCESOS DE NEGOCIO DE ACUERDO CON REQUERIMIENTOS ORGANIZACIONALES, BUENAS PRÁCTICAS DE DESARROLLO Y CRITERIOS DE CALIDAD DEL CLIENTE.",

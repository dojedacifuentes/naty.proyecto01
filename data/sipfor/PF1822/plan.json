  "FL_RUP_PLA_ACTIVO": true,
  "FL_RUP_PLA_FECVIGPER": null,
  "FL_RUP_PLA_DURACION": 190,
  "FL_RUP_PLA_DESCOPYC": "ESTE PLAN ESTÁ ORIENTADO A PROFESIONALES DEL ÁREA DEL DESARROLLO DE SOFTWARE QUE DESEAN INTEGRAR CAPACIDADES DE INTELIGENCIA ARTIFICIAL GENERATIVA EN SOLUCIONES REALES. EL EGRESADO SERÁ CAPAZ DE CONSTRUIR APLICACIONES QUE CONSUMEN MODELOS DE LENGUAJE A TRAVÉS DE APIS, ORQUESTAR FLUJOS MEDIANTE FRAMEWORKS COMO LANGCHAIN, APLICAR ESTRATEGIAS DE GENERACIÓN AUMENTADA (RAG), ALMACENAR Y CONSULTAR DATOS CON VECTORES SEMÁNTICOS Y DESARROLLAR SOLUCIONES PRODUCTIVAS INTEGRADAS MEDIANTE SERVICIOS COMO FASTAPI, DOCKER Y ALMACENAMIENTO VECTORIAL. PODRÁ DESEMPEÑARSE EN STARTUPS, EQUIPOS DE PRODUCTO, CONSULTORAS TECNOLÓGICAS, ÁREAS DE INNOVACIÓN CORPORATIVA, FINTECHS, HEALTHTECHS Y TODO TIPO DE ORGANIZACIONES QUE REQUIERAN SOLUCIONES FUNCIONALES IMPULSADAS POR IA GENERATIVA.",
  "FL_RUP_PLA_PERFSOCUP": "SIN PERFIL DE CHILEVALORA ASOCIADO",
  "FL_RUP_PLA_REQOTEC": "SIN REQUISITOS ESPECIALES",
  "FL_RUP_PLA_LICHABPART": "SIN LICENCIAS HABILITANTES",
  "FL_RUP_PLA_REQINGRE": "*EGRESADO DE CARRERA TÉCNICA, PROFESIONAL O UNIVERSITARIA DEL ÁREA TECNOLÓGICA O AFÍN. <br />*APROBACIÓN DE UN TEST DE SELECCIÓN EN LÍNEA QUE EVALÚA LA CAPACIDAD DE APRENDIZAJE Y RESOLUCIÓN DE PROBLEMAS.<br />*APROBACIÓN DE TEST, EN LÍNEA, DE CONOCIMIENTO GENERAL SOBRE PROGRAMACIÓN, DESARROLLO WEB Y APIS, USO DE TERMINAL Y GIT.",
  "FL_RUP_PLA_COMPPLAN": "DESARROLLAR APLICACIONES FUNCIONALES QUE INTEGREN INTELIGENCIA ARTIFICIAL GENERATIVA, UTILIZANDO MODELOS DE LENGUAJE, HERRAMIENTAS DE ORQUESTACIÓN, ALMACENAMIENTO VECTORIAL Y SERVICIOS BACKEND, APLICANDO PRINCIPIOS ÉTICOS Y DE SEGURIDAD, DE ACUERDO CON LOS REQUERIMIENTOS DE UN ENTORNO ORGANIZACIONAL O PRODUCTIVO.",

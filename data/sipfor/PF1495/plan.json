  "PK_RUP_PLA_NOMBRE": "HACKING ÉTICO EN APLICATIVOS WEB",
  "FL_RUP_PLA_CREADO_FEC": "2024-12-12T11:22:58.467",
  "FL_RUP_PLA_ACTIVO": true,
  "FL_RUP_PLA_FECVIGPER": null,
  "FL_RUP_PLA_DURACION": 207,
  "FL_RUP_PLA_DESCOPYC": "ESTE PLAN ESTÁ DISEÑADO PARA DESARROLLAR LOS CONOCIMIENTOS FUNDAMENTALES PARA LA IDENTIFICACIÓN, EXPLOTACIÓN Y MITIGACIÓN DE VULNERABILIDADES EN SISTEMAS Y APLICACIONES WEB, APLICANDO CRITERIOS DE SEGURIDAD, EFICIENCIA Y CUMPLIMIENTO DE ESTÁNDARES DE LA INDUSTRIA. LOS PARTICIPANTES APRENDERÁN A REALIZAR EVALUACIONES COMPLETAS DE SEGURIDAD, PROPORCIONANDO SOLUCIONES INNOVADORAS QUE ASEGUREN LA INTEGRIDAD, CONFIDENCIALIDAD Y DISPONIBILIDAD DE LOS DATOS, MIENTRAS OPTIMIZAN LOS RECURSOS DISPONIBLES.<br /><br /><br />LA OCUPACIÓN ESTÁ ORIENTADA A PROFESIONALES ESPECIALIZADOS EN LA IDENTIFICACIÓN, EXPLOTACIÓN Y MITIGACIÓN DE VULNERABILIDADES EN SISTEMAS Y APLICACIONES WEB, QUIENES APLICAN CRITERIOS DE SEGURIDAD, EFICIENCIA Y CUMPLIMIENTO DE ESTÁNDARES DE LA INDUSTRIA. ESTOS ESPECIALISTAS SON RESPONSABLES DE LLEVAR A CABO EVALUACIONES DE SEGURIDAD EXHAUSTIVAS, IMPLEMENTANDO SOLUCIONES INNOVADORAS QUE ASEGUREN LA INTEGRIDAD, CONFIDENCIALIDAD Y DISPONIBILIDAD DE LOS DATOS, AL TIEMPO QUE OPTIMIZAN LOS RECURSOS TECNOLÓGICOS DISPONIBLES.<br /><br />EN SU ROL, COLABORAN ESTRECHAMENTE CON EQUIPOS MULTIDISCIPLINARIOS INVOLUCRADOS EN EL CICLO DE VIDA DE LA SEGURIDAD DE LAS APLICACIONES WEB, TALES COMO DESARROLLADORES, JEFES DE PROYECTO, INGENIEROS DE SISTEMAS, TESTERS Y RESPONSABLES DE SEGURIDAD. UTILIZAN HERRAMIENTAS Y METODOLOGÍAS ESPECIALIZADAS PARA COORDINAR DE MANERA EFECTIVA LOS RECURSOS HUMANOS Y TECNOLÓGICOS, CON EL OBJETIVO DE RESOLVER PROBLEMAS DE SEGURIDAD CON ALTOS ESTÁNDARES DE CALIDAD Y EFICIENCIA.<br /><br />EL CAMPO LABORAL CORRESPONDE A ORGANIZACIONES, YA SEAN PÚBLICAS O PRIVADAS, TRANSVERSAL A TODAS LAS INDUSTRIAS (RETAIL, BANCA, SALUD, MINERÍA, MANUFACTURA, SERVICIOS), QUE REQUIERAN APLICAR PRÁCTICAS DE CIBERSEGURIDAD PARA PROTEGER SUS SISTEMAS WEB Y MITIGAR LOS RIESGOS ASOCIADOS A LAS AMENAZAS CIBERNÉTICAS<br />",
  "FL_RUP_PLA_PERFSOCUP": "SIN PERFIL CHILEVALORA ASOCIADO.",
  "FL_RUP_PLA_REQOTEC": "ESTE PLAN FORMATIVO FUE CREADO EN EL CONTEXTO DEL PROGRAMA TALENTO DIGITAL PARA CHILE, POR TANTO, DEBERÁ SER DICTADO POR BOOTCAMPS QUE CUENTEN CON ROL DE OTEC O BIEN, POR OTEC EN CONVENIO CON BOOTCAMPS YA SEA NACIONALES O INTERNACIONALES.",
  "FL_RUP_PLA_LICHABPART": "SIN INSTRUMENTO HABILITANTE",
  "FL_RUP_PLA_REQINGRE": "EGRESADO DE CARRERAS TÉCNICAS DE NIVEL SUPERIOR Y/O PROFESIONALES DE BASE TECNOLÓGICA O AFÍN, MÁS LA APROBACIÓN DE UN TEST DE SELECCIÓN EN LÍNEA QUE EVALÚA LA CAPACIDAD DE APRENDIZAJE Y RESOLUCIÓN DE PROBLEMAS Y LA APROBACIÓN DE TEST CONOCIMIENTOS BASALES DEL ÁREA.",
  "FL_RUP_PLA_COMPPLAN": "ASEGURAR LA SEGURIDAD EN SISTEMAS Y APLICATIVOS WEB, DESDE LA DETECCIÓN Y EXPLOTACIÓN DE VULNERABILIDADES HASTA LA IMPLEMENTACIÓN DE MEDIDAS DE MITIGACIÓN, PROPORCIONANDO INFORMES CLAROS Y EFECTIVOS, Y ASEGURANDO EL CUMPLIMIENTO DE ESTÁNDARES DE LA INDUSTRIA.",

  "FL_RUP_PLA_ACTIVO": true,
  "FL_RUP_PLA_FECVIGPER": null,
  "FL_RUP_PLA_DURACION": 141,
  "FL_RUP_PLA_DESCOPYC": "ESTE PLAN ESTÁ DISEÑADO PARA DESARROLLAR LAS HABILIDADES NECESARIAS REQUERIDAS EN LA CONFECCIÓN DE SOLUCIONES TECNOLÓGICAS PARA DIFERENTES INDUSTRIAS, LAS HABILIDADES ADQUIRIDAS PERMITEN CONOCER LAS DIFERENTES REALIDADES QUE ENFRENTAN LAS COMPAÑÍAS AL MOMENTO DE ABORDAR METODOLOGÍAS ÁGILES, CON EL OBJETIVO DE GUIAR Y ACOMPAÑAR LA CONSTRUCCIÓN DE SOLUCIONES COMO PROTAGONISTA EN EL PROCESO. EL PRODUCT OWNER SERÁ QUIEN CONOZCA A CABALIDAD LAS NECESIDADES DE LOS USUARIOS FINALES, LAS PROBLEMÁTICAS DE NEGOCIO Y LAS OPORTUNIDADES QUE EL MERCADO LE OFRECE A LA COMPAÑÍA, A FIN DE DESAFIAR LOS PROCESOS DE NEGOCIOS ACTUALES Y RESPONDER CON PRODUCTOS Y/O SERVICIOS INNOVADORES A SUS CLIENTES, GENERANDO IMPACTOS IMPORTANTES EN LA CADENA DE VALOR DE LAS ORGANIZACIONES.<br />EL CAMPO LABORAL CORRESPONDE A ORGANIZACIONES, YA SEAN PÚBLICAS O PRIVADAS, TRANSVERSAL A TODAS LAS INDUSTRIAS (RETAIL, BANCA, SALUD, MINERÍA, MANUFACTURA, SERVICIOS), QUE REQUIERAN LA CONSTRUCCIÓN DE PRODUCTOS INNOVADORES, QUE BUSQUEN EFICIENTAR SU FLUJO DE VALOR Y QUE DESEEN AVANZAR AL RITMO QUE LOS CONSUMIDORES REQUIEREN.<br />",
  "FL_RUP_PLA_PERFSOCUP": "SIN PERFIL DE CHILEVALORA ASOCIADO",
  "FL_RUP_PLA_REQOTEC": "ESTE PLAN FORMATIVO FUE CREADO EN EL CONTEXTO DEL PROGRAMA TALENTO DIGITAL PARA CHILE, POR TANTO, DEBERÁ SER DICTADO POR BOOTCAMPS QUE CUENTEN CON ROL DE OTEC O BIEN, POR OTEC EN CONVENIO CON BOOTCAMPS YA SEA NACIONALES O INTERNACIONALES.",
  "FL_RUP_PLA_LICHABPART": "SIN  INSTRUMENTO HABILITANTE",
  "FL_RUP_PLA_REQINGRE": "EGRESADO DE CARRERAS TÉCNICAS DE NIVEL SUPERIOR Y/O PROFESIONALES DE BASE CIENTÍFICA, INCLUYENDO CIENCIAS BÁSICAS, CIENCIAS SOCIALES, AGROPECUARIAS, BIOLÓGICAS Y DE LA SALUD, DEL ÁREA TECNOLOGÍA, ADMINISTRACIÓN Y COMERCIO, EDUCACIÓN, O AFÍN, MÁS LA APROBACIÓN DE UN TEST DE SELECCIÓN EN LÍNEA QUE EVALÚA LA CAPACIDAD DE APRENDIZAJE Y RESOLUCIÓN DE PROBLEMAS Y LA APROBACIÓN DE TEST CONOCIMIENTOS BASALES DEL ÁREA.",
  "FL_RUP_PLA_COMPPLAN": "IMPLEMENTAR EL DESARROLLO DE PRODUCTOS DIGITALES INNOVADORES UTILIZANDO PRÁCTICAS ÁGILES QUE APORTEN VALOR AL CLIENTE Y ESTÉ ALINEADO CON LOS OBJETIVOS DEL NEGOCIO DE ACUERDO A LAS BUENAS PRÁCTICAS DE LA INDUSTRIA.",

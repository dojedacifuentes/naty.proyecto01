# Nunca versionar
*.env
.env*
credenciales*
*credentials*
secrets*
*.key
*.pem

# PDFs: solo se versionan las bases, los entregables y los recursos finales del módulo 2
# (DECISIONS.md, 2026-09-24 y 2026-09-25). Cualquier otro PDF suelto sigue fuera.
*.pdf
!bases/*.pdf
!entregables/**/*.pdf
!modulo-2/*/entrega/**/*.pdf

# Videos e interactivos pesados: viven en Drive y su enlace va en ESTADO.md (DECISIONS.md, 2026-09-25)
*.mp4
*.mov
*.webm
*.h5p

# Trabajo local
.DS_Store
__pycache__/
*.pyc
.venv/
venv/
node_modules/
*.tmp
.scratch/

# Salidas generadas (se regeneran con scripts)
propuestas/**/build/

# Informes generados por las herramientas (se regeneran con `npm run verificar`)
state/verificacion.json
state/diferenciacion.csv

# Sitio estático que publica Vercel (npm run sitio). Se regenera en cada despliegue.
public/

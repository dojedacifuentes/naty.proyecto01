# Nunca versionar
*.env
.env*
credenciales*
*credentials*
secrets*
*.key
*.pem

# PDFs: solo se versionan las bases y los entregables (DECISIONS.md, 2026-09-24).
# Cualquier otro PDF suelto sigue fuera, para que no entre algo por accidente.
*.pdf
!bases/*.pdf
!entregables/**/*.pdf

# Trabajo local
.DS_Store
__pycache__/
*.pyc
.venv/
venv/
node_modules/
*.tmp
.scratch/

# Salidas generadas (se regeneran con scripts)
propuestas/**/build/

# Informes generados por las herramientas (se regeneran con `npm run verificar`)
state/verificacion.json
state/diferenciacion.csv

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run sitio",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)\\.(pptx|zip|gift|sql|py|csv|ipynb)",
      "headers": [{ "key": "Content-Disposition", "value": "attachment" }]
    }
  ]
}
